# HypPAR clean paper configs (override via Makefile / CLI)

# Main method: Lorentz entailment, ConvNeXt-Tiny (8GB-safe)
NAME=lorentz_entail_tiny
GEOMETRY=lorentz
SCORE_MODE=entailment
BACKBONE=convnext_tiny
STAGE_A_EPOCHS=5
STAGE_B_EPOCHS=10
BATCH_A=64
BATCH_B=32
LAMBDA_ATTR=3.0
LAMBDA_RANK=1.0
ENTAIL_BETA=1.5
UNFREEZE_MODE=full

# Stronger encoder (still aim for 8GB with AMP + BATCH_B=24)
# BACKBONE=convnext_small
# BATCH_B=24
